rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: pastikan yang akses adalah pemilik data ──
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Validasi skema TRANSAKSI ──
    function isValidTxn(d) {
      return d.keys().hasAll(['date','description','amount','categoryId','accountId','type'])
        && d.type in ['income','expense']
        && d.amount is number && d.amount > 0 && d.amount < 999999999999
        && d.description is string && d.description.size() <= 200
        && d.date is string && d.date.size() == 10
        && d.categoryId is string && d.categoryId.size() > 0
        && d.accountId  is string && d.accountId.size() > 0
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && (!('transferId' in d) || d.transferId is string)
        && (!('flow' in d) || d.flow in ['real','hutang','transfer'])
        && (!('debtId' in d) || d.debtId is string);
    }

    // ── Validasi skema ANGGARAN ──
    function isValidBudget(d) {
      return d.keys().hasAll(['categoryId','amount'])
        && d.categoryId is string && d.categoryId.size() > 0
        && d.amount is number && d.amount > 0 && d.amount < 999999999999
        && (!('period' in d) || d.period in ['harian','mingguan','bulanan','tahunan']);
    }

    // ── Validasi skema TARGET TABUNGAN / IMPIAN (termasuk Tangga Kekayaan Abadi) ──
    function isValidGoal(d) {
      return d.keys().hasAll(['name','target','current','deadline','icon','color'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.target  is number && d.target  >= 0
        && d.current is number && d.current >= 0
        && d.deadline is string
        && d.icon  is string
        && d.color is string
        && (!('ladderStep' in d) || (d.ladderStep is number && d.ladderStep >= 1 && d.ladderStep <= 7))
        && (!('autoTrack' in d) || d.autoTrack is bool);
    }

    // ── Validasi skema KATEGORI ──
    function isValidCategory(d) {
      return d.keys().hasAll(['name','type','icon','color'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.type in ['income','expense']
        && d.icon  is string
        && d.color is string;
    }

    // ── Validasi skema AKUN ──
    function isValidAccount(d) {
      return d.keys().hasAll(['name','type','icon','color'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.type in ['cash','bank','ewallet']
        && d.icon  is string
        && d.color is string;
    }

    // ── Validasi skema HUTANG / PIUTANG ──
    // Catatan: update() untuk pencatatan pembayaran hanya mengirim field {paid},
    // jadi validasi tidak mewajibkan hasAll saat field lain tidak dikirim ulang.
    function isValidDebt(d) {
      return (!('type' in d)   || d.type in ['hutang','piutang'])
        && (!('person' in d)   || (d.person is string && d.person.size() > 0 && d.person.size() <= 60))
        && (!('amount' in d)   || (d.amount is number && d.amount > 0 && d.amount < 999999999999))
        && (!('paid' in d)     || (d.paid is number && d.paid >= 0 && d.paid < 999999999999))
        && (!('dueDate' in d)  || d.dueDate == null || d.dueDate is string)
        && (!('note' in d)     || (d.note is string && d.note.size() <= 200))
        && (!('isKPR' in d)    || d.isKPR is bool);
    }

    // ── Validasi skema TARGET BERKALA ──
    // Catatan: toggle checklist mengirim update parsial {completedPeriods},
    // jadi sama seperti debt, validasi bersifat per-field (bukan hasAll penuh).
    function isValidTarget(d) {
      return (!('period' in d) || d.period in ['harian','mingguan','bulanan','tahunan'])
        && (!('mode' in d)     || d.mode in ['nominal','checklist','jadwal'])
        && (!('title' in d)    || (d.title is string && d.title.size() > 0 && d.title.size() <= 60))
        && (!('description' in d) || (d.description is string && d.description.size() <= 150))
        && (!('goalType' in d) || d.goalType in ['hemat','batas'])
        && (!('basis' in d)    || d.basis in ['total','kategori'])
        && (!('incomeCatId' in d)  || d.incomeCatId is string)
        && (!('expenseCatId' in d) || d.expenseCatId is string)
        && (!('amount' in d)   || (d.amount is number && d.amount > 0 && d.amount < 999999999999))
        && (!('completedPeriods' in d) || d.completedPeriods is list)
        && (!('schedules' in d)        || d.schedules is map)
        && (!('completedBlocks' in d)  || d.completedBlocks is map);
    }

    match /users/{userId} {

      match /transactions/{txnId} {
        allow read:          if isOwner(userId);
        allow create, update:if isOwner(userId) && isValidTxn(request.resource.data);
        allow delete:        if isOwner(userId);
      }

      match /budgets/{budId} {
        allow read:          if isOwner(userId);
        allow create, update:if isOwner(userId) && isValidBudget(request.resource.data);
        allow delete:        if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read:          if isOwner(userId);
        allow create, update:if isOwner(userId) && isValidGoal(request.resource.data);
        allow delete:        if isOwner(userId);
      }

      match /categories/{catId} {
        allow read:          if isOwner(userId);
        allow create, update:if isOwner(userId) && isValidCategory(request.resource.data);
        allow delete:        if isOwner(userId);
      }

      match /accounts/{accId} {
        allow read:          if isOwner(userId);
        allow create, update:if isOwner(userId) && isValidAccount(request.resource.data);
        allow delete:        if isOwner(userId);
      }

      match /debts/{debtId} {
        allow read:          if isOwner(userId);
        allow create, update:if isOwner(userId) && isValidDebt(request.resource.data);
        allow delete:        if isOwner(userId);
      }

      match /targets/{targetId} {
        allow read:          if isOwner(userId);
        allow create, update:if isOwner(userId) && isValidTarget(request.resource.data);
        allow delete:        if isOwner(userId);
      }

      // Settings cuma berisi { theme, currency } — risiko rendah, cukup cek kepemilikan
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default-deny mutlak: koleksi/dokumen di luar whitelist di atas
    // (termasuk subcollection tak dikenal di bawah /users/{userId}) ditolak total.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
